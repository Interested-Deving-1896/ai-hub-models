+        # ones vector; expand avoids the extra graph node and the numpy dep.
+        dims = int(value.shape[1]/self.num_heads)
+        attention_weights = attention_weights.expand(*attention_weights.shape[:-1], dims)
+
+        # Calculate sampling locations based on reference points and offsets
+        if reference_points.shape[1] == 2:
+            offset_normalizer = torch.stack(
+                [spatial_shapes[..., 1], spatial_shapes[..., 0]], -1)
+
+            if self.use_grid_sample:
+                offset_normalizer = 1/offset_normalizer[None, None, :, :]
+                reference_points = reference_points[:,:,:,:] * 2 - 1
+                offset_normalizer = 2 * offset_normalizer
+
+                if bs > 1:
+                    sampling_locations = (reference_points.permute(0, 2, 3, 1).reshape(bs, num_query, -1, 2)\
+                                        + sampling_offsets * offset_normalizer)
+                else:
+                    offset_normalizer = offset_normalizer.repeat(1, 1, self.num_heads*self.num_levels*self.num_points, 1)
+                    sampling_offsets *= offset_normalizer.reshape(1, -1, 1, 1)
+                    reference_points = reference_points.repeat(self.num_heads*self.num_levels*self.num_points, 1, 1, 1)
+                    # Remove Reshape Node
+                    sampling_locations = reference_points.reshape(1, -1, num_query1, num_query2) + sampling_offsets
+            else:
+                """
+                Added for the grid_sample Replacement
+                """
+                offset_normalizer = offset_normalizer.repeat(1, 1, self.num_heads*self.num_levels*self.num_points, 1)
+                reference_points = reference_points.repeat(self.num_heads*self.num_levels*self.num_points, 1, 1, 1)\
+                                    .reshape(1, -1, num_query1, num_query2)
+                sampling_locations = ((reference_points * offset_normalizer.reshape(1, -1, 1, 1) + 0.5) + sampling_offsets)
+
+        elif reference_points.shape[1] == 4:
+            sampling_locations = reference_points[:, :, None, :, None, :2]\
+                                    + sampling_offsets / self.num_points * reference_points[:, :, None, :, None, 2:] * 0.5
+        else:
+            raise ValueError(
+                f'Last dim of reference_points must be'
+                f' 2 or 4, but got {reference_points.shape[-1]} instead.')
+
+        # Calculate sampling_grid
+        if bs > 1:
+            sampling_grid = sampling_locations.reshape(-1, num_query, self.num_heads, self.num_points*2)\
+                                .transpose(2, 1).reshape(-1, num_query, self.num_points, 2)
+        else:
+            if self.use_grid_sample:
+                sampling_grid = sampling_locations.view(-1, self.num_points*2, num_query1, num_query2)\
+                                    .permute(0, 2, 3, 1).reshape(-1, num_query, self.num_points, 2)
+            else:
+                """
+                Added for the grid_sample Replacement
+                """
+                sampling_grid = sampling_locations.view(-1, self.num_points,2, num_query)
+
+        # Apply the custom multi-scale deformable attention function
+        if self.use_grid_sample:
+            # output = custom_multi_scale_deformable_attn_pytorch_decoder_single_grid(value, spatial_shapes, sampling_grid, attention_weights,
+            #                                                     self.num_heads, self.grid_sample_mode, self.training)
+            output = custom_multi_scale_deformable_attn_pytorch_single_grid(value, spatial_shapes,
+                                                                      sampling_locations.view(-1, self.num_points, 2, num_query1* num_query2).permute(0,1,3,2),
+                                                                      attention_weights, self.num_heads, self.grid_sample_mode, self.training)
+
+
+        output = output.reshape(-1, num_query1, num_query2, self.dim_per_head)\
+                    .permute(0, 3, 1, 2).reshape(bs, -1, num_query1, num_query2)
+
+        output = self.output_proj(output)
+
+        if self.original_code:
+            if not self.batch_first:
+                # (num_query, bs ,embed_dims)
+                output = output.permute(1, 0, 2)
+
+        return self.dropout(output) + identity
+
