+                attn_scores = [attn_scores[i:i + 1] for i in range(attn_scores.shape[0])]
+
+            # Split value for each head
+            value_heads = [value[:, :, :, i * E: (i + 1) * E] for i in range(batch_size * num_heads)]
+
+            # Compute output by multiplying attention scores with values
+            output = [torch.matmul(attn_scores[i], value_heads[i]) for i in range(len(attn_scores))]
