+        q_proj = linear(query, weight_q, bias=bias_q)
+        k_proj = linear(key, weight_k, bias=bias_k)
+        v_proj = linear(value, weight_v, bias=bias_v)
+
+        return q_proj, k_proj, v_proj
+
+    def _scaled_dot_product_attention(
+        self,
+        query: Tensor,
+        key: Tensor,
+        value: Tensor,
+        batch_size: int,
+        num_heads: int,
+        dropout_p: float = 0.0,
+    ) -> Tuple[Tensor, Tensor]:
+        """
+        Compute scaled dot product attention.
+        Args:
+            query (Tensor): Query tensor.
+            key (Tensor): Key tensor.
+            value (Tensor): Value tensor.
+            batch_size (int): Batch size.
+            num_heads (int): Number of attention heads.
+            dropout_p (float, optional): Dropout probability. Default is 0.0.
+
+        Returns:
+            Tuple[Tensor, Tensor]: Attention output and attention weights.
+        """
+        E = int(query.shape[-1]) // (num_heads * batch_size)
+        query = query / math.sqrt(E)
+        query_len = query.shape[1] * query.shape[2]
+        query_len_h, query_len_w = query.shape[1], query.shape[2]
+
+        if self.split_heads:
