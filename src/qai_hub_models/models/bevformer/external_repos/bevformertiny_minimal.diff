+        # Calculate sampling_grid
+        if bs > 1:
+            sampling_grid = sampling_locations.reshape(-1, self.num_points, 2, num_query).permute(0, 3, 1, 2)
+        else:
+            if self.use_grid_sample:
+                sampling_grid = torch.stack((torch.stack(torch.cat(sampling_locations.view(self.num_heads,2,self.num_points*2,num_query).split(1, dim=1), dim=0)[:,0].split(1, dim=1), dim=-1)[:,0].split(2, dim=-1)), dim=1)
+            else:
+                """
+                Added for the grid_sample Replacement
+                """
+                sampling_grid = sampling_locations.view(self.num_heads, -1,self.num_points*2, num_query )\
+                                    .transpose(1, 0).contiguous().view(-1,self.num_points, 2, num_query)
+
+        # Apply the custom multi-scale deformable attention function
+        if self.use_grid_sample:
+            output = custom_multi_scale_deformable_attn_pytorch_single_grid(value, spatial_shapes, sampling_grid, attention_weights,
+                                                                self.num_heads, self.grid_sample_mode, self.training)
