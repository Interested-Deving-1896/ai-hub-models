# Converts bare module imports to relative imports for package structure
# compatibility. Also rewrites the YOLOLayer / JDELayer inference branches
# to avoid in-place slice assignments on a 5D tensor (io[..., :2] = ...).
# torch.export lowers those as scatter ops that blow up the compiled QNN
# graph: pt2 exports of yolor either fail to finalize the QNN graph or run
# ~10x slower. The rewrite flattens the prediction to 2D and builds the
# output with torch.cat, preserving the yolov5-style math bit-exact.
#
diff --git a/models/models.py b/models/models.py
index 76c44b6..244e6af 100644
--- a/models/models.py
+++ b/models/models.py
@@ -1,7 +1,7 @@
-from utils.google_utils import *
-from utils.layers import *
-from utils.parse_config import *
-from utils import torch_utils
+from ..utils.google_utils import *
+from ..utils.layers import *
+from ..utils.parse_config import *
+from ..utils import torch_utils

 ONNX_EXPORT = False

@@ -417,16 +417,18 @@ class YOLOLayer(nn.Module):
             return p_cls, xy * ng, wh

         else:  # inference
-            io = p.sigmoid()
-            io[..., :2] = (io[..., :2] * 2. - 0.5 + self.grid)
-            io[..., 2:4] = (io[..., 2:4] * 2) ** 2 * self.anchor_wh
-            io[..., :4] *= self.stride
-            #io = p.clone()  # inference output
-            #io[..., :2] = torch.sigmoid(io[..., :2]) + self.grid  # xy
-            #io[..., 2:4] = torch.exp(io[..., 2:4]) * self.anchor_wh  # wh yolo method
-            #io[..., :4] *= self.stride
-            #torch.sigmoid_(io[..., 4:])
-            return io.view(bs, -1, self.no), p  # view [1, 3, 13, 13, 85] as [1, 507, 85]
+            # pt2-friendly: avoid in-place slice assignments on a 5D tensor
+            # (io[..., :2] = ..., etc.). torch.export lowers these as scatter
+            # ops that blow up the compiled QNN graph.
+            m = self.na * self.nx * self.ny
+            grid = self.grid.repeat(1, self.na, 1, 1, 1).view(m, 2)
+            anchor_wh = self.anchor_wh.repeat(1, 1, self.nx, self.ny, 1).view(m, 2)
+            p_flat = p.view(bs * m, self.no)
+            io = p_flat.sigmoid()
+            xy = (io[:, 0:2] * 2. - 0.5 + grid.repeat(bs, 1)) * self.stride
+            wh = (io[:, 2:4] * 2) ** 2 * anchor_wh.repeat(bs, 1) * self.stride
+            io_out = torch.cat([xy, wh, io[:, 4:]], dim=-1)
+            return io_out.view(bs, m, self.no), p_flat


 class JDELayer(nn.Module):
@@ -510,16 +512,16 @@ class JDELayer(nn.Module):
             return p_cls, xy * ng, wh

         else:  # inference
-            #io = p.sigmoid()
-            #io[..., :2] = (io[..., :2] * 2. - 0.5 + self.grid)
-            #io[..., 2:4] = (io[..., 2:4] * 2) ** 2 * self.anchor_wh
-            #io[..., :4] *= self.stride
-            io = p.clone()  # inference output
-            io[..., :2] = torch.sigmoid(io[..., :2]) * 2. - 0.5 + self.grid  # xy
-            io[..., 2:4] = (torch.sigmoid(io[..., 2:4]) * 2) ** 2 * self.anchor_wh  # wh yolo method
-            io[..., :4] *= self.stride
-            io[..., 4:] = F.softmax(io[..., 4:])
-            return io.view(bs, -1, self.no), p  # view [1, 3, 13, 13, 85] as [1, 507, 85]
+            # pt2-friendly: avoid in-place slice assignments (see YOLOLayer).
+            m = self.na * self.nx * self.ny
+            grid = self.grid.repeat(1, self.na, 1, 1, 1).view(m, 2)
+            anchor_wh = self.anchor_wh.repeat(1, 1, self.nx, self.ny, 1).view(m, 2)
+            p_flat = p.view(bs * m, self.no)
+            xy = (torch.sigmoid(p_flat[:, 0:2]) * 2. - 0.5 + grid.repeat(bs, 1)) * self.stride
+            wh = (torch.sigmoid(p_flat[:, 2:4]) * 2) ** 2 * anchor_wh.repeat(bs, 1) * self.stride
+            cls = F.softmax(p_flat[:, 4:], dim=-1)
+            io_out = torch.cat([xy, wh, cls], dim=-1)
+            return io_out.view(bs, m, self.no), p_flat

